# 仅列出服务端环境变量约定，不会自动读取，不含真实账号或密码。
# loadMySqlConfigFromEnvironment() 读取进程环境变量；复制此文件不会自动加载。
# 不把真实值写回本文件，不向 Qt 客户端分发数据库账号。
STORAGE_DB_HOST=127.0.0.1
STORAGE_DB_PORT=3306
STORAGE_DB_NAME=
STORAGE_DB_USER=
STORAGE_DB_PASSWORD=
STORAGE_DB_CONNECT_TIMEOUT=3
STORAGE_DB_READ_TIMEOUT=3
STORAGE_DB_WRITE_TIMEOUT=3
STORAGE_DB_REQUIRE_VERIFIED_TLS=1
# 1: 验证 CA 和服务器身份，必须填 CA 路径，HOST 必须匹配服务器证书。
# 0: 本机练习显式选择，只强制 TLS 加密，不验证服务器身份；不会降级明文。
STORAGE_DB_TLS_CA_FILE=
